# Copy this file to .env and fill in your key.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Paddle billing (optional). The app defaults to the free plan, which never
# calls OpenAI regardless of the key above — leave all of this blank and the
# app simply stays free/AI-off forever, at zero risk of API cost. Fill these
# in once you have a Paddle account to let a single Pro purchase (paid by you,
# the app owner) unlock AI for the whole deployment:
#   PADDLE_CLIENT_TOKEN  — client-side token from Paddle > Developer Tools > Authentication
#   PADDLE_PRICE_ID      — the price ID for your Pro plan/product
#   PADDLE_WEBHOOK_SECRET — notification secret from the webhook you point at
#                           POST /api/paddle/webhook in Paddle > Developer Tools > Notifications
#   PADDLE_ENVIRONMENT   — "sandbox" while testing, "production" when live
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
# Optional: lets you flip the plan locally (POST /api/billing/dev-set-plan)
# without a real Paddle webhook, for testing. Leave blank in production —
# anyone holding this token can turn AI on for free.
PADDLE_DEV_OVERRIDE_TOKEN=

# Google sign-in — must be the SAME client ID as the frontend's
# VITE_GOOGLE_CLIENT_ID (see frontend/.env.example). The backend uses it to
# verify that a Google ID token was really issued for this app before trusting
# it. Leave blank and "Sign in with Google" / guest login both still work —
# guest login has no Google dependency, and Google sign-in just returns a
# clear 401 until this is set.
GOOGLE_CLIENT_ID=

# How extreme a move must be (in %) to show up in a scan
SCAN_MIN_ABS_PERCENT=8.0
# Minimum day volume, filters out illiquid noise
SCAN_MIN_VOLUME=100000
# Max rows kept per scan (after client-side re-sort). The scanner itself finds
# everything matching the filters (up to ~500) — this only trims how many get
# enriched with news/analyst data + an AI summary and shown in the panel.
SCAN_MAX_RESULTS=100
# Filter out warrants/rights/units (SPAC-style tickers), keep only common stock
SCAN_EXCLUDE_DERIVATIVES=true

# "Broken stocks" watchlist: penny stocks that used to be worth real money and
# collapsed over the trailing year — independent of what they did today.
BROKEN_MAX_PRICE=2.0
BROKEN_MIN_DRAWDOWN_PERCENT=60.0
BROKEN_MIN_VOLUME=20000

# Scan schedule, 24h HH:MM, in the timezone below. The two mover scans run
# twice a day; the broken-stocks watchlist refreshes once a day since it
# barely moves hour to hour.
SCAN_TIME_1=09:45
SCAN_TIME_2=16:15
BROKEN_SCAN_TIME=08:30
SCAN_TIMEZONE=America/New_York

DATABASE_URL=sqlite:///./stockbot.db
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Telegram alerts, forex pairs (breakout + 3 touches on the 1h chart, checked every 4
# hours). Token from @BotFather; then message the bot and run `python -m app.telegram`
# to get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily (Mon-Fri, SCAN_TIMEZONE) list of pairs still inside a 3-touch 4h zone.
ZONE_TOUCH_ALERT_TIME=16:45
# Candle times in the alert messages.
ALERT_TIMEZONE=Asia/Jerusalem
# The scanner page the alerts link to; it opens the alert's chart with its marking.
# (A local one needs 127.0.0.1, not localhost: Telegram drops localhost links.)
ALERT_CHART_URL=https://stock-one-flax.vercel.app/

# Note: port 8000 is used by another local service on this machine, so this
# backend runs on 8001 (see run.py / package.json proxy).
