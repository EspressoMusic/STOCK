# Copy this file to .env and fill in your key.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# How extreme a move must be (in %) to show up in a scan
SCAN_MIN_ABS_PERCENT=8.0
# Minimum day volume, filters out illiquid noise
SCAN_MIN_VOLUME=100000
# Max rows kept per scan (after client-side re-sort). The scanner itself finds
# everything matching the filters (up to ~500) — this only trims how many get
# enriched with news/analyst data + an AI summary and shown in the panel.
SCAN_MAX_RESULTS=100
# Filter out warrants/rights/units (SPAC-style tickers), keep only common stock
SCAN_EXCLUDE_DERIVATIVES=true

# "Broken stocks" watchlist: penny stocks that used to be worth real money and
# collapsed over the trailing year — independent of what they did today.
BROKEN_MAX_PRICE=2.0
BROKEN_MIN_DRAWDOWN_PERCENT=60.0
BROKEN_MIN_VOLUME=20000

# Scan schedule, 24h HH:MM, in the timezone below. The two mover scans run
# twice a day; the broken-stocks watchlist refreshes once a day since it
# barely moves hour to hour.
SCAN_TIME_1=09:45
SCAN_TIME_2=16:15
BROKEN_SCAN_TIME=08:30
SCAN_TIMEZONE=America/New_York

DATABASE_URL=sqlite:///./stockbot.db
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Note: port 8000 is used by another local service on this machine, so this
# backend runs on 8001 (see run.py / package.json proxy).
