VITE_API_BASE=http://127.0.0.1:8001

# Required for the "Sign in with Google" button in Settings.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# (APIs & Services > Credentials), add your dev origin (e.g. http://localhost:5174)
# under "Authorized JavaScript origins", then paste the client ID below.
VITE_GOOGLE_CLIENT_ID=
